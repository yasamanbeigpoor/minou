  "grammars": [
    {
      "id": "g-fiche",
      "title": "Filling in a form",
      "section": "Fiche biographique",
      "pages": "class handout",
      "teach": [
        {
          "title": "The lines on the form",
          "body": "A <b>fiche biographique</b> asks for your basic facts. The one trap: <b>nom</b> is your <b>last</b> name, and <b>prénom</b> is your first name.",
          "table": {
            "head": [
              "",
              "On the form"
            ],
            "rows": [
              [
                "last name",
                "nom"
              ],
              [
                "first name",
                "prénom"
              ],
              [
                "sex",
                "sexe"
              ],
              [
                "male / female",
                "masculin / féminin"
              ],
              [
                "age",
                "âge"
              ],
              [
                "city",
                "ville"
              ],
              [
                "province",
                "province"
              ],
              [
                "postal code",
                "code postal"
              ],
              [
                "phone number",
                "numéro de téléphone"
              ],
              [
                "email address",
                "adresse mail"
              ],
              [
                "hobbies and likes",
                "passe-temps et préférences"
              ]
            ]
          },
          "trick": "Pré = before: the prénom comes before the nom. Léa (prénom) Tremblay (nom)."
        },
        {
          "title": "The questions behind each line",
          "body": "Someone filling the form with you will ask these. Notice <b>J'ai … ans</b>: in French you <i>have</i> an age.",
          "examples": [
            {
              "fr": "Quel est ton nom ?",
              "en": "What's your last name?",
              "pr": "kel ay tohn NOHN",
              "fa": "کِل اِ تُن نُن"
            },
            {
              "fr": "Quel est ton prénom ?",
              "en": "What's your first name?",
              "pr": "kel ay tohn pray-NOHN",
              "fa": "کِل اِ تُن پرِنُن"
            },
            {
              "fr": "Quel âge as-tu ?",
              "en": "How old are you?",
              "pr": "kel AHZH ah-TÜ",
              "fa": "کِل آژ آتو"
            },
            {
              "fr": "J'ai vingt-deux ans.",
              "en": "I'm twenty-two.",
              "pr": "zhay vant-duh-ZAHN",
              "fa": "ژِ وَنت‌دُزان"
            },
            {
              "fr": "Où habites-tu ?",
              "en": "Where do you live?",
              "pr": "OO ah-beet-TÜ",
              "fa": "او آبیت‌تو"
            },
            {
              "fr": "J'habite à Ottawa, en Ontario.",
              "en": "I live in Ottawa, in Ontario.",
              "pr": "zhah-BEET ah oh-tah-WAH, ahn-nohn-tah-RYOH",
              "fa": "ژابیت آ اُتاوا، آنُنتاریُ"
            },
            {
              "fr": "Quel est ton numéro de téléphone ?",
              "en": "What's your phone number?",
              "pr": "kel ay tohn nü-may-ROH duh tay-lay-FOHN",
              "fa": "کِل اِ تُن نومِرُ دُ تِلِفُن"
            },
            {
              "fr": "Quelle est ton adresse mail ?",
              "en": "What's your email address?",
              "pr": "kel ay tohn-nah-DRESS MEHL",
              "fa": "کِل اِ تُنادرِس مِیل"
            },
            {
              "fr": "Quels sont tes passe-temps ?",
              "en": "What are your hobbies?",
              "pr": "kel sohn tay pahss-TAHN",
              "fa": "کِل سُن تِ پاس‌تان"
            }
          ],
          "trick": "Age uses avoir: J'ai 22 ans, never “je suis 22”."
        },
        {
          "title": "Spelling it out loud",
          "body": "Read an email address symbol by symbol: <b>@</b> = <b>arobase</b>, <b>.</b> = <b>point</b>, <b>-</b> = <b>tiret</b>, <b>_</b> = <b>tiret bas</b>.<br><br>For a postal code, use the French letter names: <b>K1N 6N5</b> = “ka, un, enne, six, enne, cinq”.<br><br>In Canada, phone numbers are usually read in groups or digit by digit: 613 555 0142.",
          "examples": [
            {
              "fr": "léa point tremblay arobase exemple point ca",
              "en": "lea.tremblay@exemple.ca",
              "pr": "lay-AH pwan trahn-BLAY ah-roh-BAHZ eg-ZAHN-pluh pwan say-AH",
              "fa": "لِآ پوآن ترانبلِ آروباز اِگزانپل پوآن سِآ"
            }
          ],
          "trick": "Arobase = @. Point = dot."
        },
        {
          "grid": true,
          "say": "J'habite en Ontario.",
          "sub": "Provinces: en for most, au for masculine ones. Tap each one to hear it.",
          "tiles": [
            {
              "big": "ON",
              "fr": "en Ontario",
              "pr": "ahn-nohn-tah-RYOH",
              "fa": "آنُنتاریُ"
            },
            {
              "big": "QC",
              "fr": "au Québec",
              "pr": "oh kay-BEK",
              "fa": "اُ کِبِک"
            },
            {
              "big": "BC",
              "fr": "en Colombie-Britannique",
              "pr": "ahn koh-lohn-BEE bree-tah-NEEK",
              "fa": "آن کُلُنبی بریتانیک"
            },
            {
              "big": "AB",
              "fr": "en Alberta",
              "pr": "ahn-nahl-behr-TAH",
              "fa": "آنآلبِرتا"
            },
            {
              "big": "MB",
              "fr": "au Manitoba",
              "pr": "oh mah-nee-toh-BAH",
              "fa": "اُ مانیتُبا"
            },
            {
              "big": "NS",
              "fr": "en Nouvelle-Écosse",
              "pr": "ahn noo-VEL ay-KOSS",
              "fa": "آن نووِل اِکُس"
            }
          ]
        },
        {
          "title": "Hobbies and likes",
          "body": "For <b>passe-temps et préférences</b>, use what you learned in Module 2: <b>J'aime</b> + a verb or a thing.",
          "examples": [
            {
              "fr": "J'aime nager, lire et écouter de la musique.",
              "en": "I like swimming, reading and listening to music.",
              "pr": "ZHEM nah-ZHAY, LEER ay ay-koo-TAY duh lah mü-ZEEK",
              "fa": "ژِم ناژه، لیر اِ اِکوته دُ لا موزیک"
            },
            {
              "fr": "J'adore le cinéma.",
              "en": "I love movies.",
              "pr": "zhah-DOR luh see-nay-MAH",
              "fa": "ژادُر لُ سینِما"
            }
          ]
        }
      ],
      "notes": [
        "nom = last name. prénom = first name.",
        "sexe: masculin (male) / féminin (female).",
        "Age uses avoir: J'ai 22 ans.",
        "@ = arobase, . = point, - = tiret, _ = tiret bas.",
        "Postal codes use the French letter names: K1N 6N5 = ka, un, enne, six, enne, cinq.",
        "en Ontario, en Alberta… but au Québec, au Manitoba."
      ],
      "tricks": {
        "nom": "Nom is your last name. Pré-nom comes before it.",
        "age": "In French you have an age: J'ai 22 ans.",
        "mail": "Arobase = @, point = dot.",
        "prov": "en for most provinces, au for masculine ones (le Québec, le Manitoba)."
      },
