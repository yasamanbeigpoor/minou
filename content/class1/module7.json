  "grammars": [
    {
      "id": "g23",
      "title": "The verb aller, contractions of à",
      "section": "Grammaire 2.3",
      "pages": "pp. 98–99",
      "teach": [
        {
          "title": "Aller: to go",
          "body": "<b>Aller</b> is irregular: it doesn't follow the -er pattern. Je <b>vais</b>, tu <b>vas</b> and il <b>va</b> all start with v; only nous and vous keep <b>all-</b>.",
          "table": {
            "head": [
              "",
              "aller"
            ],
            "rows": [
              [
                "I",
                "je vais"
              ],
              [
                "you (tu)",
                "tu vas"
              ],
              [
                "he / she / one",
                "il va"
              ],
              [
                "we",
                "nous allons"
              ],
              [
                "you (vous)",
                "vous allez"
              ],
              [
                "they",
                "ils vont"
              ]
            ]
          },
          "examples": [
            {
              "fr": "Qu'est-ce que vous faites ce soir ?",
              "en": "What are you doing tonight?",
              "pr": "kess-kuh voo FET suh SWAR",
              "fa": "کِسکُ وو فِت سُ سوآر"
            },
            {
              "fr": "Nous allons chez Raoul.",
              "en": "We're going to Raoul's.",
              "pr": "noo-zah-LOHN shay rah-OOL",
              "fa": "نوزالُن شِ رائول"
            },
            {
              "fr": "Mes parents vont à l'église tous les dimanches.",
              "en": "My parents go to church every Sunday.",
              "pr": "may pah-RAHN vohn-tah lay-GLEEZ too lay dee-MAHNSH",
              "fa": "مِ پاران وُنتا لِگلیز تو لِ دیمانش"
            }
          ],
          "trick": "Ils vont rhymes with ils font, ils sont, ils ont. Nous_allons and vous_allez link with a z."
        },
        {
          "title": "à + le = au, à + les = aux",
          "body": "To say “to” a place, use <b>à</b>. Like de, it merges with le and les: <b>à + le = au</b>, <b>à + les = aux</b>. <b>À la</b> and <b>à l'</b> don't change.",
          "table": {
            "head": [
              "",
              "to the …"
            ],
            "rows": [
              [
                "à + le",
                "au"
              ],
              [
                "à + la",
                "à la"
              ],
              [
                "à + l'",
                "à l'"
              ],
              [
                "à + les",
                "aux"
              ]
            ]
          },
          "examples": [
            {
              "fr": "Ils vont souvent au café avec leurs amis.",
              "en": "They often go to the café with their friends.",
              "pr": "eel vohn soo-VAHN oh kah-FAY ah-VEK luhr-zah-MEE",
              "fa": "ایل وُن سووان اُ کافه آوِک لُرزامی"
            },
            {
              "fr": "Bernard aime aller aux Halles quand il va à Paris.",
              "en": "Bernard likes to go to Les Halles when he goes to Paris.",
              "pr": "behr-NAR EM ah-LAY oh AHL kahn-teel VAH ah pah-REE",
              "fa": "بِرنار اِم آله اُ آل کانتیل وا آ پاری"
            },
            {
              "fr": "Allons-y !",
              "en": "Let's go!",
              "pr": "ah-lohn-ZEE",
              "fa": "آلُنزی"
            },
            {
              "fr": "Vas-y ! Allez-y !",
              "en": "Go ahead!",
              "pr": "vah-ZEE! ah-lay-ZEE",
              "fa": "وازی! آلِزی"
            }
          ],
          "trick": "Same rule as de: only le and les merge. au, aux; but à la, à l'."
        },
        {
          "title": "Y = there",
          "body": "<b>Y</b> replaces <b>à</b> + a place (or dans / chez + a place). It means “there” and goes right before the verb.",
          "examples": [
            {
              "fr": "Est-ce que Fatima va à la bibliothèque aujourd'hui ?",
              "en": "Is Fatima going to the library today?",
              "pr": "ess-kuh fah-tee-MAH VAH ah lah bee-blee-oh-TEK oh-zhoor-DWEE",
              "fa": "اِسکُ فاتیما وا آ لا بیبلیُتِک اُژوردوئی"
            },
            {
              "fr": "Oui, elle y va après ses cours.",
              "en": "Yes, she's going (there) after her classes.",
              "pr": "WEE, el-ee VAH ah-PREH say KOOR",
              "fa": "وی، اِلی وا آپرِ سِ کور"
            },
            {
              "fr": "Tu vas chez Denise ce soir ? Oui, j'y vais.",
              "en": "Are you going to Denise's tonight? Yes, I'm going.",
              "pr": "tü VAH shay duh-NEEZ suh SWAR? WEE, zhee VEH",
              "fa": "تو وا شِ دُنیز سُ سوآر؟ وی، ژی وِ"
            },
            {
