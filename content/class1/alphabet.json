      "name": "a accent grave",
      "pr": "ah ak-sahn GRAHV",
      "fa": "آ آکسان گراو",
      "hint": "Same sound as a. It only tells two words apart: à means “to, at”, a means “has”.",
      "trick": "The accent on à is a signpost pointing somewhere: à Paris = to Paris.",
      "words": [
        "à",
        "voilà",
        "là"
      ],
      "wordsEn": {
        "à": "to, at",
        "voilà": "there you go",
        "là": "there"
      },
      "swap": [
