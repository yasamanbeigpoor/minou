    {
      "id": "circ",
      "mark": "ê",
      "name": "e accent circonflexe",
      "pr": "uh ak-sahn seer-kohn-FLEKS",
      "fa": "اُ آکسان سیرکُنفلِکس",
      "hint": "Also an open “eh”, like è.",
      "trick": "The circonflexe is a little hat hiding a lost s from old French: fête = feast, forêt = forest, tête (think “testa”).",
      "words": [
        "fête",
        "tête",
        "être"
      ],
      "wordsEn": {
        "fête": "party",
        "tête": "head",
        "être": "to be"
      },
      "swap": [
        "e",
        "é",
        "è"
      ]
    },
    {
      "id": "trema",
      "mark": "ë",
      "name": "e tréma",
      "pr": "uh tray-MAH",
      "fa": "اُ ترِما",
      "hint": "Two dots: say this vowel separately from the one before it.",
      "trick": "The two dots split the vowels apart: Noël is “no-el”, not “nole”.",
      "words": [
        "Noël"
      ],
      "wordsEn": {
        "Noël": "Christmas"
      },
      "swap": [
        "e",
        "é",
        "è"
