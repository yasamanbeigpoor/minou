  "grammars": [
    {
      "id": "g16",
      "title": "Contractions of de",
      "section": "Grammaire 1.6",
      "pages": "pp. 73–74",
      "teach": [
        {
          "title": "Paul's car = the car of Paul",
          "body": "French has no <b>'s</b>. Say “the car <b>of</b> Paul”: the thing first, then <b>de</b> + the person.",
          "examples": [
            {
              "fr": "la voiture de Paul",
              "en": "Paul's car",
              "pr": "lah vwah-TÜR duh POHL",
              "fa": "لا ووآتور دُ پُل"
            },
            {
              "fr": "Est-ce que c'est la sœur de Denise ?",
              "en": "Is that Denise's sister?",
              "pr": "ess-kuh SAY lah SUHR duh duh-NEEZ",
              "fa": "اِسکُ سِ لا سُر دُ دُنیز"
            },
            {
              "fr": "Oui, c'est sa sœur.",
              "en": "Yes, that's her sister.",
              "pr": "WEE, SAY sah SUHR",
              "fa": "وی، سِ سا سُر"
            }
          ],
          "trick": "Flip it: Paul's car → the car of Paul → la voiture de Paul."
        },
        {
          "title": "de + le = du, de + les = des",
          "body": "When <b>de</b> meets <b>le</b> or <b>les</b>, they join: <b>de + le = du</b>, <b>de + les = des</b>. <b>De la</b> and <b>de l'</b> never change.",
          "table": {
            "head": [
              "",
              "the … of"
            ],
            "rows": [
              [
                "de + le",
                "du"
              ],
              [
                "de + la",
                "de la"
              ],
              [
                "de + l'",
                "de l'"
              ],
              [
                "de + les",
                "des"
              ]
            ]
          },
          "examples": [
            {
              "fr": "Voici les livres du professeur.",
              "en": "Here are the teacher's books.",
              "pr": "vwah-SEE lay LEE-vruh dü proh-feh-SUHR",
              "fa": "وواسی لِ لیوخ دو پروفِسُر"
            },
            {
              "fr": "C'est la voiture des amis de Patrick.",
              "en": "It's Patrick's friends' car.",
              "pr": "SAY lah vwah-TÜR day-zah-MEE duh pah-TREEK",
              "fa": "سِ لا ووآتور دِزامی دُ پاتریک"
            },
            {
              "fr": "Voici la sœur de l'amie de Sarah.",
              "en": "Here is Sarah's friend's sister.",
              "pr": "vwah-SEE lah SUHR duh lah-MEE duh sah-RAH",
              "fa": "وواسی لا سُر دُ لامی دُ سارا"
            }
          ],
          "trick": "Only the boys merge: le and les join with de (du, des). La and l' stay apart."
        },
        {
          "title": "A person who isn't named",
          "body": "To talk about someone without their name, use <b>de</b> + article + noun. You can chain them.",
          "examples": [
            {
              "fr": "C'est le chat de la sœur de Paul.",
              "en": "It's Paul's sister's cat.",
              "pr": "SAY luh SHAH duh lah SUHR duh POHL",
              "fa": "سِ لُ شا دُ لا سُر دُ پُل"
            },
            {
              "fr": "La femme de l'oncle Victor a 43 ans.",
              "en": "Uncle Victor's wife is 43 years old.",
              "pr": "lah FAHM duh LOHN-kluh veek-TOR ah kah-RAHNT-TRWAH-ZAHN",
              "fa": "لا فام دُ لُنکل ویکتُر آ کارانت‌تروآزان"
            },
            {
              "fr": "le mari de la femme blonde",
              "en": "the blond woman's husband",
              "pr": "luh mah-REE duh lah FAHM BLOHND",
              "fa": "لُ ماری دُ لا فام بلُند"
            }
          ]
        },
        {
          "title": "Des has two meanings",
          "body": "1. <b>des</b> = some, the plural of un / une: un ami algérien → <b>des</b> amis algériens.<br>2. <b>des</b> = of the (de + les): Voilà le père <b>des</b> enfants.",
          "examples": [
            {
              "fr": "des amis algériens",
              "en": "(some) Algerian friends",
              "pr": "day-zah-MEE ahl-zhay-RYAN",
              "fa": "دِزامی آلژِریَن"
            },
            {
              "fr": "Voilà le père des enfants.",
              "en": "There's the children's father.",
              "pr": "vwah-LAH luh PEHR day-zahn-FAHN",
              "fa": "وُآلا لُ پِر دِزانفان"
            }
          ],
          "trick": "Ask: can I say “of the”? Yes → de + les. No → it just means “some”."
        }
      ],
      "notes": [
        "No 's in French: la voiture de Paul = Paul's car (the car of Paul).",
        "de + le = du, de + les = des. De la and de l' don't change.",
        "Person without a name: de + article + noun: le chat de la sœur de Paul.",
        "Des = some (plural of un/une) or of the (de + les)."
      ],
      "tricks": {
        "de": "Flip it: Paul's car → la voiture de Paul.",
        "contract": "Only le and les merge with de: du, des. La and l' stay apart.",
        "des": "Can you say “of the”? Then des = de + les. If not, des = some."
      },
