  "grammars": [
    {
      "id": "g25",
      "title": "Pouvoir, vouloir and savoir",
      "section": "Grammaire 2.5",
      "pages": "pp. 100–102",
      "teach": [
        {
          "title": "Pouvoir (can) and vouloir (want)",
          "body": "These two irregular verbs work the same way: <b>eu</b> in je, tu, il and ils; <b>ou</b> in nous and vous. Like aimer, they're followed by an infinitive.",
          "table": {
            "head": [
              "",
              "pouvoir",
              "vouloir"
            ],
            "rows": [
              [
                "I",
                "je peux",
                "je veux"
              ],
              [
                "you (tu)",
                "tu peux",
                "tu veux"
              ],
              [
                "he / she / one",
                "il peut",
                "il veut"
              ],
              [
                "we",
                "nous pouvons",
                "nous voulons"
              ],
              [
                "you (vous)",
                "vous pouvez",
                "vous voulez"
              ],
              [
                "they",
                "ils peuvent",
                "ils veulent"
              ]
            ]
          },
          "examples": [
            {
              "fr": "Je veux manger.",
              "en": "I want to eat.",
              "pr": "zhuh vuh mahn-ZHAY",
              "fa": "ژُ وُ مانژه"
            },
            {
              "fr": "Tu peux sortir ce soir ?",
              "en": "Can you go out tonight?",
              "pr": "tü puh sor-TEER suh SWAR",
              "fa": "تو پُ سُرتیر سُ سوآر"
            },
            {
              "fr": "Tu veux aller au cinéma ce soir ?",
              "en": "Do you want to go to the movies tonight?",
              "pr": "tü vuh ah-LAY oh see-nay-MAH suh SWAR",
              "fa": "تو وُ آله اُ سینِما سُ سوآر"
            },
            {
              "fr": "Je ne peux pas. Je suis fauché.",
              "en": "I can't. I'm broke.",
              "pr": "zhuh nuh puh PAH. zhuh swee foh-SHAY",
              "fa": "ژُ نُ پُ پا. ژُ سوئی فُشه"
            }
          ],
          "trick": "The “boot”: je, tu, il, ils say eu (peux, veux); nous and vous say ou (pouvons, voulons)."
        },
        {
          "title": "Saying no",
          "body": "Wrap <b>ne … pas</b> around pouvoir or vouloir; the infinitive comes after.",
          "examples": [
            {
              "fr": "Je ne veux pas sortir.",
              "en": "I don't want to go out.",
              "pr": "zhuh nuh vuh PAH sor-TEER",
              "fa": "ژُ نُ وُ پا سُرتیر"
            },
            {
              "fr": "Je ne peux pas dormir.",
              "en": "I can't sleep.",
              "pr": "zhuh nuh puh PAH dor-MEER",
              "fa": "ژُ نُ پُ پا دُرمیر"
            }
          ]
        },
        {
          "title": "Savoir: to know a fact",
          "body": "Use <b>savoir</b> for facts and information.",
          "table": {
            "head": [
              "",
              "savoir"
            ],
            "rows": [
              [
                "I",
                "je sais"
              ],
              [
                "you (tu)",
                "tu sais"
              ],
              [
                "he / she / one",
                "il sait"
              ],
              [
                "we",
                "nous savons"
              ],
              [
                "you (vous)",
                "vous savez"
              ],
              [
                "they",
                "ils savent"
              ]
            ]
          },
          "examples": [
            {
              "fr": "Tu sais la date d'aujourd'hui ?",
              "en": "Do you know today's date?",
              "pr": "tü SEH lah DAHT doh-zhoor-DWEE",
              "fa": "تو سِ لا دات دُژوردوئی"
            },
            {
              "fr": "Je ne sais pas son adresse mail.",
              "en": "I don't know her email address.",
              "pr": "zhuh nuh seh PAH sohn-nah-DRESS MEHL",
              "fa": "ژُ نُ سِ پا سُنادرِس مِیل"
            },
            {
              "fr": "Je sais que c'est vrai.",
              "en": "I know that it's true.",
              "pr": "zhuh SEH kuh seh VREH",
              "fa": "ژُ سِ کُ سِ ورِ"
            }
          ],
          "trick": "Sais, sais, sait all sound like “seh”."
        },
        {
          "title": "Savoir + infinitive: know how to",
          "body": "<b>Savoir</b> + an infinitive means knowing <b>how</b> to do something.",
          "examples": [
            {
              "fr": "Je sais nager.",
              "en": "I know how to swim.",
              "pr": "zhuh SEH nah-ZHAY",
              "fa": "ژُ سِ ناژه"
            },
            {
              "fr": "Je ne sais pas danser.",
              "en": "I don't know how to dance.",
              "pr": "zhuh nuh seh PAH dahn-SAY",
              "fa": "ژُ نُ سِ پا دانسه"
            },
            {
              "fr": "Tu sais cuisiner, n'est-ce pas ?",
              "en": "You know how to cook, don't you?",
              "pr": "tü SEH kwee-zee-NAY, ness-PAH",
              "fa": "تو سِ کویزینه، نِس پا"
            }
          ],
          "trick": "Can I swim? Je sais nager (I've learned it). Je peux nager (I'm allowed / able right now)."
        },
        {
          "title": "Being polite: je voudrais",
          "body": "<b>Je voudrais</b> or <b>j'aimerais</b> (I would like) is softer than <b>je veux</b>. Also: tu voudrais, il voudrait.",
          "examples": [
            {
              "fr": "Je voudrais dormir maintenant !",
              "en": "I'd like to sleep now!",
              "pr": "zhuh voo-DREH dor-MEER mant-NAHN",
              "fa": "ژُ وودرِ دُرمیر مَنتنان"
            },
            {
              "fr": "Où est-ce que tu aimerais voyager ?",
              "en": "Where would you like to travel?",
              "pr": "oo ess-kuh tü em-REH vwah-yah-ZHAY",
              "fa": "او اِسکُ تو اِمرِ ووآیاژه"
            },
            {
              "fr": "Je voudrais aller en France.",
              "en": "I'd like to go to France.",
              "pr": "zhuh voo-DREH ah-LAY ahn FRAHNSS",
              "fa": "ژُ وودرِ آله آن فرانس"
            }
          ],
          "trick": "In a shop or café, always je voudrais: Je voudrais un café, s'il vous plaît."
        }
      ],
      "notes": [
        "pouvoir: je peux, tu peux, il peut, nous pouvons, vous pouvez, ils peuvent.",
        "vouloir: je veux, tu veux, il veut, nous voulons, vous voulez, ils veulent.",
        "savoir: je sais, tu sais, il sait, nous savons, vous savez, ils savent.",
        "All three + infinitive: je veux manger, tu peux sortir, je sais nager.",
        "Negative: je ne peux pas dormir.",
        "Polite: je voudrais / j'aimerais = I would like."
      ],
      "tricks": {
        "pv": "Pouvoir and vouloir are twins: eu for je, tu, il, ils; ou for nous, vous.",
        "savoir": "Savoir = know a fact or know how. Sais, sais, sait = “seh”.",
        "poli": "Je voudrais is the polite je veux."
      },
